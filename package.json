{
  "name": "trivialperms",
  "version": "2.1.0",
  "description": "A simple RBAC implementation that is datasource agnostic.",
  "type": "module",
  "main": "dist/cjs/trivialperms.cjs",
  "module": "dist/esm/trivialperms.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/cjs/trivialperms.d.cts",
        "default": "./dist/cjs/trivialperms.cjs"
      },
      "import": {
        "types": "./dist/esm/trivialperms.d.ts",
        "default": "./dist/esm/trivialperms.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "duel -d",
    "test": "mocha --require tsx test/**/*.spec.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix"
  },
  "keywords": [
    "json",
    "rbac",
    "permissions",
    "roles"
  ],
  "author": "Christopher S. Case <chris.case@g33xnexus.com>",
  "bugs": "https://github.com/trivialsoftware/trivial-permissions/issues",
  "homepage": "http://trivialsoftware.github.io/trivial-permissions/",
  "repository": {
    "type": "git",
    "url": "https://github.com/trivialsoftware/trivial-permissions.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@knighted/duel": "^4.0.2",
    "@stylistic/eslint-plugin": "^5.7.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "chai": "^5.1.1",
    "eslint": "^9.28.0",
    "globals": "^17.1.0",
    "mocha": "^11.7.5",
    "tsx": "^4.16.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.34.0"
  }
}
