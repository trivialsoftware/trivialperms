{
    "compilerOptions": {
        "declaration": true,
        "target": "esnext",
        "module": "nodenext",
        "outDir": "dist",
        "erasableSyntaxOnly": true,

        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "noUncheckedSideEffectImports": true,

        "skipLibCheck": true,
        "sourceMap": true
    },
    "files": [
        "src/trivialperms.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
